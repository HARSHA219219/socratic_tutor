# Copy to backend/.env and fill in. Never commit the real .env.
OPENROUTER_API_KEY=
# PostgreSQL via Docker (run `docker compose up -d` in the repo root, then `alembic upgrade head` here)
DATABASE_URL=postgresql+asyncpg://socratic_user:socratic_password@localhost:5434/socratic_tutor
# Or local SQLite, no Docker needed:
# DATABASE_URL=sqlite+aiosqlite:///./my_new_database.db
# Use a long random value in production (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Your deployed frontend URL(s), comma-separated. Leave unset locally to allow all.
# CORS_ORIGINS=https://your-frontend.onrender.com
# Optional (defaults shown)
# IMAGE_STORAGE_DIR=./uploads/images
# MAX_IMAGE_BYTES=5242880
# MAX_HISTORY_IMAGES=3
# DOCUMENT_STORAGE_DIR=./uploads/documents
# MAX_DOCUMENT_BYTES=10485760
# MAX_DOCUMENT_TEXT_CHARS=20000
# MAX_PDF_IMAGE_PAGES=4
# MAX_ATTACHMENTS_PER_MESSAGE=5
# MAX_TOTAL_ATTACHMENT_BYTES=20971520
# ATTACHMENT_CONTEXT_PERCENT=45
# IMAGE_SUMMARY_ENABLED=true
# IMAGE_SUMMARY_MAX_TOKENS=300
# SUMMARY_ENABLED=true
# SUMMARY_WARNING_PERCENT=80
# SUMMARY_MAX_TOKENS=1500
# CONTEXT_TOKEN_BUDGET=16000
# STUDENT_TOKEN_EXPIRE_MINUTES=720
